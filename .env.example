DATABASE_URL="mysql://mcvv:mcvv@localhost:3306/mcvv"

# TLS is mandatory when NODE_ENV=production and enabled by default there.
# For a local TLS integration test, set DATABASE_TLS=true. Production cannot opt out.
# DATABASE_TLS="true"
# Optional path to the server's trusted CA bundle. Otherwise Node's CA roots are used.
# DATABASE_SSL_CA="/run/certs/mysql-ca.crt"
# Use a plain mysql:// URL without TLS query parameters; db:migrate translates
# this shared policy into Prisma CLI's sslcert + sslaccept=strict parameters.

# Dedicated shadow database for `prisma migrate dev` (MySQL/MariaDB strictly requires
# a *different* database than the main one).
# Create it + grant rights with the one-time command documented in compose.dev.yaml.
# See: https://pris.ly/d/migrate-shadow
SHADOW_DATABASE_URL="mysql://mcvv:mcvv@localhost:3306/mcvv_shadow"

TIME_ZONE="Europe/Prague"

# GitHub delivery settings (CI only; configure in GitHub Settings, not local .env).
# GITHUB_ACTIONS, GITHUB_REPOSITORY, GITHUB_REF_NAME, GITHUB_SHA,
# GITHUB_RUN_NUMBER, GITHUB_RUN_ATTEMPT, GITHUB_HEAD_REF, GITHUB_BASE_REF,
# GITHUB_REF_TYPE are provided by Actions.
# INFRA_REPOSITORY="kobchocen/chc-azure-terraform"
# INFRA_BUILD_REF="<published 40-character infrastructure commit>"
# INFRA_SOURCE_PATH=".local/infra"
# ACR_NAME="<existing Azure container registry name>"
# PUBLIC_BUILD_ENV_JSON="{}"
# GH_TOKEN / RELEASE_TOKEN, INFRA_READ_TOKEN, INFRA_DEPLOY_TOKEN are GitHub secrets.
# AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID configure azure/login OIDC.
# HELM_REGISTRY_CONFIG is set by the workflow to the Docker login config.

# Auth (set locally, never commit real passwords)
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Pavel
ORGANIZER_EMAIL=
ORGANIZER_PASSWORD=
ORGANIZER_NAME=Martin

# Public registration (Resend). Never commit real keys.
RESEND_API_KEY=
MAIL_FROM=
# Newsletter: "true" = rozesílka publiku se jen zaloguje (nic se neodešle).
# Výchozí: true mimo NODE_ENV=production. Testovací e-mail se posílá vždy přes Resend.
NEWSLETTER_DRY_RUN=

# OAuth (leave empty to hide the provider button). Never commit real keys.
AUTH_ORIGIN=http://localhost:3000

# Public canonical origin for sitemap.xml and robots.txt (default https://mcvv.org)
SITE_URL=

# Max runtime of `pnpm db:migrate` (prisma migrate deploy) in seconds, 30–3600 (default 900)
DB_MIGRATE_TIMEOUT_SECONDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# E-mailová fronta (Resend Free = 100/den, reset v UTC)
# MAIL_DRY_RUN=true            # mimo produkci výchozí true – nic se reálně neodesílá
# MAIL_DAILY_CAP=90            # vlastní denní strop fronty + newsletteru (výchozí; admin Nastavení má přednost)
# MAIL_PRIORITY_RESERVE=15     # rezerva pro potvrzení přihlášek, ověřovací e-maily a alerty
# ALERT_TO=mcvv@mcvv.org       # kam chodí alerty (limit, chyby jobů)
# CRON_SECRET=                 # min. 32 znaků; Bearer token pro POST /api/cron/*
# FIO_API_TOKEN=               # read-only token Fio (použije PR s párováním plateb)

# Párování plateb Fio (POST /api/cron/payments)
# PAYMENTS_DRY_RUN=true        # výchozí true mimo APP_ENV=prod – jen záznam pohybů, bez plateb/potvrzení
# FIO_MODE=last                # výchozí last v produkci (+ 1× denně kontrolní /periods/ 7 dní), jinak periods
# REMINDERS_DRY_RUN=true       # výchozí true mimo APP_ENV=prod – připomínky se jen spočítají

# Den závodu – publikace do OFeed (#122). Event ID a heslo akce se zadávají v adminu
# (/admin/den-zavodu/zive), heslo je v DB zašifrované klíčem odvozeným ze SESSION_SECRET.
# OFEED_DRY_RUN=true          # výchozí true mimo APP_ENV=prod – XML se jen vygeneruje, nic se neposílá
# OFEED_API_URL=https://api.orienteerfeed.com   # jen pro testy / lokální mock
# OFEED_SCHEDULER=false       # vypne automatický upload každých 30 s (cron/admin tlačítko zůstanou)

# Ochrana profilů běžců /cs|en/bezec/* před crawlery (#199), v paměti každé instance
# BEZEC_RATE_LIMIT=120         # max. zobrazení profilů za minutu z jedné IP (0 = vypnuto); nad limit HTTP 429
# Veřejné online výsledky /api/live/results, v paměti každé instance (den závodu, CGNAT)
# LIVE_RESULTS_RATE_LIMIT=12000 # max. dotazů za minutu z jedné IP (0 = vypnuto); záložka = 12 / min
# IP klienta = poslední hop X-Forwarded-For (přidává ho ACA ingress); cf-connecting-ip jen když
# provoz opravdu jde přes Cloudflare proxy a origin bere jen Cloudflare:
# TRUST_CF_CONNECTING_IP=false
