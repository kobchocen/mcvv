%% MCVV databáze – aktuální stav (origin/develop, včetně #321)
%% 51 tabulek. U každé jen PK, FK a 2–4 klíčové sloupce.
%% Plná čára = Prisma/DB relace (@relation / FK).
%% Čárkovaná čára = logická vazba bez FK v DB (rok, číslo, user_id, …).
%% Zdroj: prisma/schema.prisma na origin/develop.
%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#F4F1EA",
    "primaryTextColor": "#1B1B1B",
    "primaryBorderColor": "#4A5568",
    "lineColor": "#3E4A5A",
    "secondaryColor": "#E6EEF7",
