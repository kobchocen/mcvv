// Prisma schema for MCVV (Malá cena Velké Verandy)
// Generated from legacy MySQL CREATE TABLE statements in docs/sql_create.sql
// Includes referential integrity via @relation where columns clearly reference PKs.
// Table and column names are preserved via @@map / @map for compatibility with old data.
// Models use camelCase fields for better DX.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  // url and shadowDatabaseUrl are provided via prisma.config.ts (Prisma 7+ style)
  // Development requires a separate shadow database; production uses migrate deploy.
}

// ============================================
// Číselníky (dictionaries / lookups)
// ============================================

/// Číselník kategorií MCVV
model Category {
  id       String @id @map("id") @db.Char(1)
  name     String @map("jmeno") @db.VarChar(20)
  age      Int    @map("age") @db.SmallInt
  sort     Int    @map("sort") @db.SmallInt
  sex      String @map("sex") @db.Char(1)
  record   Int    @map("rekord") @db.SmallInt
  entryFee Int    @map("startovne") @db.SmallInt
  bibFrom  Int    @map("cislo_od") @db.SmallInt
  bibTo    Int    @map("cislo_do") @db.SmallInt

  // Relations (reverse)
  registrationLines RegistrationLine[]
  startEntries      StartEntry[]
  results           Result[]

  @@map("cis_mcvv_kateg")
}

/// Číselník běžců (master data)
model Runner {
  id      String    @id @map("id") @db.Char(8)
  name    String    @map("jmeno") @db.VarChar(50)
  created DateTime? @map("created")
  author  String?   @map("autor") @db.VarChar(64) // legacy user ref (length varies)

  // Relations
  runnerPhotos      RunnerPhoto[]
  webImages         WebImage[]
  registrationLines RegistrationLine[]
  startEntries      StartEntry[]
  results           Result[]
  startLineMetas    StartLineMeta[]

  @@map("cis_bezec")
}

/// Číselník fotografů
model PhotoAuthor {
  id   String @id @map("id") @db.Char(1)
  desc String @map("popis") @db.VarChar(30)

  // photos Photo[]  // can be added if data uses 1-char codes consistently

  @@map("cis_fotka_autor")
}

/// Číselník místa fotografie
model PhotoLocation {
  id   String @id @map("id") @db.Char(1)
  desc String @map("popis") @db.VarChar(20)
  sort Int    @map("sort") @db.SmallInt

  photos Photo[]

  @@map("cis_fotka_kde")
}

/// Číselník klubů v rámci roků (composite key: id + rok)
model Club {
  id      String    @map("id") @db.Char(3)
  year    Int       @map("rok") @db.SmallInt
  name    String    @map("jmeno") @db.VarChar(50)
  created DateTime? @map("created")
  author  String?   @map("autor") @db.VarChar(64)

  // Relations
  registrationLines RegistrationLine[]
  startEntries      StartEntry[]
  results           Result[]

  @@id([id, year])
  @@map("cis_klub")
}

/// Číselník typů obrázků pro web
model WebImageType {
  id   Int    @id @default(autoincrement()) @map("id") @db.SmallInt
  desc String @map("popis") @db.VarChar(20)

  webImages WebImage[]

  @@map("cis_typ_webimages")
}

// ============================================
// Hlavní doménové tabulky
// ============================================

/// Základní info o jednotlivých ročnících závodu
model Edition {
  id               Int       @id @default(autoincrement()) @map("id") @db.SmallInt
  date             DateTime  @map("datum") @db.Date
  weather          String?   @map("weather") @db.VarChar(64)
  temp             Int?      @map("temp") @db.SmallInt
  zhl              Boolean?  @default(true) @map("zhl")
  isCarEx          Boolean?  @default(false) @map("iscarex")
  regDeadline      DateTime? @map("prihl_datum") @db.Date
  regEmail         String?   @default("mcvv@mcvv.org") @map("prihl_mail") @db.VarChar(32)
  startKidsMail    Int?      @default(20) @map("start_deti_mail") @db.SmallInt
  startKidsPlace   Int?      @default(50) @map("start_deti_mist") @db.SmallInt
  startAdultMail   Int?      @default(50) @map("start_dosp_mail") @db.SmallInt
  startAdultPlace  Int?      @default(100) @map("start_dosp_mist") @db.SmallInt
  startInterval    Int?      @default(15) @map("st_interval") @db.SmallInt
  infoEmail        String?   @default("mcvv@mcvv.org") @map("infomail") @db.VarChar(32)
  infoWww          String?   @default("www.mcvv.org") @map("infowww") @db.VarChar(32)
  infoTel          String?   @default("") @map("infotel") @db.VarChar(16)
  // Ceny v cíli
  finAdult1        Int?      @default(2000) @map("fin_dosp_1") @db.SmallInt
  finAdult2        Int?      @default(1000) @map("fin_dosp_2") @db.SmallInt
  finAdult3        Int?      @default(500) @map("fin_dosp_3") @db.SmallInt
  finAdult4        Int?      @default(200) @map("fin_dosp_4") @db.SmallInt
  finAdult5        Int?      @default(100) @map("fin_dosp_5") @db.SmallInt
  finVet1          Int?      @default(300) @map("fin_vet_1") @db.SmallInt
  finVet2          Int?      @default(200) @map("fin_vet_2") @db.SmallInt
  finVet3          Int?      @default(100) @map("fin_vet_3") @db.SmallInt
  // Model startu (#114): nulový čas v sekundách od půlnoci (Europe/Prague), 1. číslo 2. startu,
  // čísla obhájců (absolutní vítězové minulého ročníku, muži a ženy).
  startZeroSeconds Int       @default(36900) @map("st_nula_s")
  secondStartFrom  Int       @default(601) @map("st_druhy_od") @db.SmallInt
  championBibMen   Int?      @default(400) @map("st_obhajce_m") @db.SmallInt
  championBibWomen Int?      @default(950) @map("st_obhajce_z") @db.SmallInt

  @@map("mcvv_info")
}

/// Data fotek (včetně původního blobu)
model Photo {
  id               Int       @id @default(autoincrement()) @map("id") @db.Int
  year             Int       @map("rok") @db.SmallInt
  locationId       String    @map("kde_id") @db.Char(1)
  debugText        String?   @map("debug_text") @db.Text
  created          DateTime? @map("created")
  originalFilename String?   @map("original_filename") @db.VarChar(255)
  authorId         String?   @map("autor") @db.VarChar(8) // could reference users or PhotoAuthor
  image            Bytes?    @map("image") // longblob – never select in list queries
  hasImage         Boolean   @default(false) @map("has_image")
  width            Int?      @map("width")
  height           Int?      @map("height")

  location PhotoLocation @relation(fields: [locationId], references: [id])
  runners  RunnerPhoto[]

  @@index([year, hasImage], map: "mcvv_fotky_rok_has_image_idx")
  @@map("mcvv_fotky")
}

/// Asociační tabulka běžec ↔ fotka
model RunnerPhoto {
  photoId       Int    @map("fotka_id") @db.Int
  runnerId      String @map("bezec_id") @db.Char(8)
  orderFromLeft Int?   @map("poradi_zleva") @db.SmallInt

  photo  Photo  @relation(fields: [photoId], references: [id])
  runner Runner @relation(fields: [runnerId], references: [id])

  @@id([photoId, runnerId])
  @@map("mcvv_bezec_fotka")
}

/// Novinky na webu
model News {
  id         Int      @id @default(autoincrement()) @map("id") @db.SmallInt
  date       DateTime @default(now()) @map("datum")
  title      String?  @map("nadpis") @db.VarChar(64)
  lead       String?  @map("uvod") @db.MediumText
  content    String?  @map("obsah") @db.Text
  webImageId Int      @map("webimage_id") @db.SmallInt

  webImage WebImage @relation(fields: [webImageId], references: [id])

  @@map("mcvv_news")
}

/// Obrázky pro web (včetně blobu)
model WebImage {
  id       Int     @id @default(autoincrement()) @map("id") @db.SmallInt
  typeId   Int     @map("typ_id") @db.SmallInt
  runnerId String? @map("bezec_id") @db.Char(8)
  desc     String  @map("popis") @db.VarChar(128)
  year     Int?    @map("rok") @db.SmallInt
  image    Bytes?  @map("image") // mediumblob

  type   WebImageType @relation(fields: [typeId], references: [id])
  runner Runner?      @relation(fields: [runnerId], references: [id])

  news News[]

  @@map("webimages")
}

// ============================================
// Přihlášky a výsledky
// ============================================

/// Hlavička přihlášky (composite PK: rok + id)
model Registration {
  year         Int       @map("rok") @db.SmallInt
  id           Int       @map("id") @db.SmallInt
  email        String?   @map("email") @db.VarChar(128)
  type         String?   @map("typ") @db.Char(1)
  note         String?   @map("poznamka") @db.MediumText
  created      DateTime? @map("created")
  name         String?   @map("nazev") @db.VarChar(128)
  securityCode String?   @map("securitycode") @db.VarChar(32)
  status       Int?      @map("stav") @db.SmallInt
  author       String?   @map("autor") @db.VarChar(64)
  promotion    String?   @map("promotion") @db.VarChar(32)

  lines RegistrationLine[]

  @@id([year, id])
  @@map("mcvv_prihlaska")
}

/// Řádek přihlášky (jeden běžec v přihlášce)
model RegistrationLine {
  runnerId       String    @map("bezec_id") @db.Char(8)
  clubId         String    @map("klub_id") @db.Char(3)
  categoryId     String    @map("kateg_id") @db.Char(1)
  year           Int       @map("rok") @db.SmallInt
  bib            Int?      @map("cislo") @db.SmallInt
  registrationId Int       @map("prihlaska_id") @db.SmallInt
  entryFee       Int?      @map("startovne") @db.SmallInt
  note           String?   @map("poznamka") @db.VarChar(128)
  created        DateTime? @map("created")
  author         String?   @map("autor") @db.VarChar(64)

  runner       Runner       @relation(fields: [runnerId], references: [id])
  club         Club         @relation(fields: [clubId, year], references: [id, year])
  category     Category     @relation(fields: [categoryId], references: [id])
  registration Registration @relation(fields: [year, registrationId], references: [year, id])

  @@id([year, runnerId])
  @@map("mcvv_prihlaska_radek")
}

/// Platby za startovné
/// Pozn: prihlaska_id je v legacy definováno jako char(3) – zachováno, relace není striktní.
model Payment {
  id             Int       @id @default(autoincrement()) @map("id") @db.Int
  year           Int       @default(2018) @map("rok") @db.SmallInt
  registrationId String    @map("prihlaska_id") @db.Char(3)
  date           DateTime? @map("datum") @db.Date
  amount         Int?      @map("castka") @db.SmallInt
  created        DateTime  @default(now()) @map("created")
  author         String?   @default("admin") @map("autor") @db.VarChar(8)

  @@map("mcvv_platba")
}

/// Startovní listina (přiřazená čísla)
model StartEntry {
  runnerId   String  @map("bezec_id") @db.Char(8)
  clubId     String  @map("klub_id") @db.Char(3)
  categoryId String  @map("kateg_id") @db.Char(1)
  year       Int     @map("rok") @db.SmallInt
  bib        Int     @map("cislo") @db.SmallInt
  runnerName String? @map("bezec_name") @db.VarChar(50)
  clubName   String? @map("klub_name") @db.VarChar(50)

  runner   Runner   @relation(fields: [runnerId], references: [id])
  club     Club     @relation(fields: [clubId, year], references: [id, year])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([year, runnerId])
  @@map("mcvv_start")
}

/// Výsledky / časy
model Result {
  runnerId   String  @map("bezec_id") @db.Char(8)
  year       Int     @map("rok") @db.SmallInt
  clubId     String  @map("klub_id") @db.Char(3)
  categoryId String  @map("kateg_id") @db.Char(1)
  time       Int     @map("time") @db.SmallInt // v sekundách
  runnerName String? @map("bezec_name") @db.VarChar(50)
  clubName   String? @map("klub_name") @db.VarChar(50)

  runner   Runner   @relation(fields: [runnerId], references: [id])
  club     Club     @relation(fields: [clubId, year], references: [id, year])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([year, runnerId])
  @@map("mcvv_time")
}

/// Mezičasy (splits)
model Split {
  bib     Int       @map("cislo") @db.SmallInt
  year    Int       @map("rok") @db.SmallInt
  split   String    @map("split") @db.Char(1)
  time    Int       @map("time") @db.SmallInt
  created DateTime? @map("created")
  author  String?   @map("autor") @db.VarChar(8)

  @@id([bib, year, split])
  @@map("mcvv_split")
}

// ============================================
// Ostatní
// ============================================

/// Klíč–hodnota nastavení webu
model Setting {
  key  String @id @map("klic") @db.VarChar(64)
  text String @map("text") @db.MediumText

  @@map("mcvv_setting")
}

enum UserRole {
  registrar
  organizer
  admin
  /// „Časomíra“ (externí dodavatel OBD): jen sekce „Den závodu“ v administraci.
  timing
  /// Obsluha mezičasových kontrol: jen stránka mezičasů (#121).
  splitmaker
}

/// Application accounts (hashed passwords). Not the legacy `users` table.
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  name          String    @db.VarChar(80)
  clubName      String?   @map("club_name") @db.VarChar(50)
  role          UserRole
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  emailTokens    EmailVerificationToken[]
  newsletters    NewsletterCampaign[]
  messageThreads MessageThread[]
  messages       Message[]
  auditEntries   AuditLog[]

  @@map("mcvv_user")
}

/// Auditní záznam akcí v administraci (#107): změny rolí, exporty a importy dne závodu.
/// Jméno a e-mail aktéra se ukládají i jako text, aby záznam přežil smazání účtu.
model AuditLog {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now()) @map("created_at")
  actorUserId Int?     @map("actor_user_id")
  actorEmail  String   @map("actor_email") @db.VarChar(255)
  actorRole   String   @map("actor_role") @db.VarChar(20)
  /// Např. "user.role_change", "raceday.obd_export".
  action      String   @db.VarChar(64)
  /// Cíl akce (např. "user:12", "year:2026").
  target      String?  @db.VarChar(128)
  /// Strukturované detaily (z čeho na co, počty řádků…). Bez osobních údajů navíc.
  detail      Json?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@map("mcvv_audit_log")
}

enum EmailTokenPurpose {
  verify
  reset
}

model EmailVerificationToken {
  id        Int               @id @default(autoincrement())
  userId    Int               @map("user_id")
  tokenHash String            @unique @map("token_hash") @db.VarChar(64)
  purpose   EmailTokenPurpose @default(verify)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcvv_email_token")
}

/// Sponzoři / partneři
model Sponsor {
  id          Int      @id @default(autoincrement()) @map("id") @db.SmallInt
  name        String?  @map("nazev") @db.VarChar(128)
  link        String?  @map("link") @db.VarChar(128)
  image       String?  @map("image") @db.VarChar(64)
  category    Int      @map("category") @db.SmallInt
  order       Int      @map("poradi") @db.SmallInt
  active      Boolean? @map("active")
  description String   @map("description") @db.VarChar(1024)
  /// Uploaded logo bytes (PNG/JPEG/WebP or sanitized SVG); never select in list queries
  logo        Bytes?   @map("logo") @db.MediumBlob
  logoType    String?  @map("logo_type") @db.VarChar(32)
  logoHash    String?  @map("logo_hash") @db.Char(16)

  @@map("sponsors")
}

// ============================================
// Newsletter
// ============================================

enum NewsletterStatus {
  draft
  test_sent
  sending
  sent
}

enum NewsletterRecipientStatus {
  pending
  sending
  sent
  failed
  skipped
}

/// Newsletterová kampaň (obsah v Markdownu, odeslání po dávkách).
model NewsletterCampaign {
  id                     Int              @id @default(autoincrement())
  subject                String           @db.VarChar(200)
  body                   String           @db.Text
  status                 NewsletterStatus @default(draft)
  /// Zahrnout ověřené registrované uživatele (mcvv_user).
  audienceUsers          Boolean          @default(true) @map("audience_users")
  /// Zahrnout e-maily z přihlášek za posledních N let (0 = ne).
  audienceYears          Int              @default(0) @map("audience_years") @db.SmallInt
  /// Vyřadit adresy přihlášené na aktuální ročník (kontaktní e-mail přihlášky i autor řádků).
  excludeCurrentEntrants Boolean          @default(true) @map("exclude_current_entrants")
  createdById            Int?             @map("created_by_id")
  testSentAt             DateTime?        @map("test_sent_at")
  startedAt              DateTime?        @map("started_at")
  sentAt                 DateTime?        @map("sent_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  createdBy  User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients NewsletterRecipient[]

  @@index([createdById])
  @@map("mcvv_newsletter")
}

/// Log příjemců kampaně; unikátní (kampaň, e-mail) brání dvojímu odeslání.
model NewsletterRecipient {
  id         Int                       @id @default(autoincrement())
  campaignId Int                       @map("campaign_id")
  email      String                    @db.VarChar(255)
  status     NewsletterRecipientStatus @default(pending)
  error      String?                   @db.VarChar(500)
  claimToken String?                   @map("claim_token") @db.VarChar(36)
  claimedAt  DateTime?                 @map("claimed_at")
  providerId String?                   @map("provider_id") @db.VarChar(64)
  sentAt     DateTime?                 @map("sent_at")
  createdAt  DateTime                  @default(now()) @map("created_at")

  campaign NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([sentAt])
  @@index([claimToken])
  @@map("mcvv_newsletter_recipient")
}

/// Odhlášení z newsletteru (token v odkazu je stabilní pro daný e-mail).
model NewsletterOptOut {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(255)
  token          String    @unique @db.VarChar(64)
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("mcvv_newsletter_optout")
}

enum MailKind {
  auth
  confirmation
  alert
  contact
  reminder
  summary
  other
  message
}

enum MailQueueStatus {
  pending
  sending
  sent
  failed
}

/// Fronta odchozích e-mailů (denní limit Resend). Newsletter má vlastní tabulku příjemců,
/// ale počítá se do stejného denního limitu.
model MailQueue {
  id         Int             @id @default(autoincrement())
  kind       MailKind
  /// 0 = potvrzení/auth/alert (smí čerpat rezervu), 1 = ostatní.
  priority   Int             @default(1) @db.TinyInt
  toEmail    String          @map("to_email") @db.VarChar(255)
  replyTo    String?         @map("reply_to") @db.VarChar(255)
  subject    String          @db.VarChar(300)
  html       String          @db.MediumText
  text       String          @db.MediumText
  /// Volitelný klíč proti dvojímu zařazení (např. "reminder1:2026:32").
  dedupeKey  String?         @unique @map("dedupe_key") @db.VarChar(120)
  status     MailQueueStatus @default(pending)
  attempts   Int             @default(0) @db.SmallInt
  notBefore  DateTime        @default(now()) @map("not_before")
  claimToken String?         @map("claim_token") @db.VarChar(36)
  claimedAt  DateTime?       @map("claimed_at")
  lastError  String?         @map("last_error") @db.VarChar(500)
  providerId String?         @map("provider_id") @db.VarChar(64)
  sentAt     DateTime?       @map("sent_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([status, priority, notBefore])
  @@index([sentAt])
  @@index([claimToken])
  @@map("mcvv_mail_queue")
}

/// Denní příznaky e-mailové kvóty (den v UTC – tak resetuje Resend).
model MailDay {
  day             DateTime  @id @db.Date
  quotaExceededAt DateTime? @map("quota_exceeded_at")
  capAlertSentAt  DateTime? @map("cap_alert_sent_at")

  @@map("mcvv_mail_day")
}

enum BankTxStatus {
  processing
  matched
  unmatched
  ignored
  dry_run
}

/// Příchozí pohyb z Fio API (jen platby s VS začínajícím aktuálním ročníkem).
model BankTx {
  id             Int          @id @default(autoincrement())
  fioId          BigInt       @unique @map("fio_id")
  date           DateTime     @map("datum") @db.Date
  amount         Decimal      @map("castka") @db.Decimal(10, 2)
  currency       String       @map("mena") @db.VarChar(3)
  vs             String?      @db.VarChar(20)
  counterAccount String?      @map("protiucet") @db.VarChar(64)
  counterName    String?      @map("protiucet_nazev") @db.VarChar(255)
  message        String?      @map("zprava") @db.VarChar(255)
  raw            Json
  status         BankTxStatus @default(processing) @map("stav")
  /// Kód důvodu (např. not_found, cancelled, vs_malformed, underpaid, currency, interrupted).
  reason         String?      @map("duvod") @db.VarChar(40)
  year           Int?         @map("rok") @db.SmallInt
  registrationId Int?         @map("prihlaska_id") @db.SmallInt
  paymentId      Int?         @map("platba_id")
  /// Přeplatek v Kč (k vrácení po závodě).
  overpaid       Int          @default(0) @map("preplatek")
  refundedAt     DateTime?    @map("vraceno_at")
  autoConfirmed  Boolean      @default(false) @map("auto_potvrzeno")
  note           String?      @map("poznamka") @db.VarChar(500)
  resolvedBy     String?      @map("vyresil") @db.VarChar(64)
  summarizedAt   DateTime?    @map("v_souhrnu_at")
  createdAt      DateTime     @default(now()) @map("created")
  updatedAt      DateTime     @updatedAt @map("updated")

  @@index([status])
  @@index([year, registrationId])
  @@map("mcvv_bank_tx")
}

/// Stav plánovaných jobů (kurzor Fio, poslední požadavek…).
model JobState {
  name      String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mcvv_job_state")
}

/// Audit běhů plánovaných jobů.
model JobRun {
  id         Int       @id @default(autoincrement())
  job        String    @db.VarChar(32)
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  ok         Boolean?
  mode       String?   @db.VarChar(16)
  fetched    Int       @default(0)
  matched    Int       @default(0)
  unmatched  Int       @default(0)
  error      String?   @db.VarChar(500)

  @@index([job, startedAt])
  @@map("mcvv_job_run")
}

/// Doplňková data přihlášky (legacy tabulka mcvv_prihlaska se nemění):
/// poslední změna a odeslané připomínky platby.
model RegistrationMeta {
  year        Int       @map("rok") @db.SmallInt
  id          Int       @map("id") @db.SmallInt
  updatedAt   DateTime? @map("updated_at")
  reminder1At DateTime? @map("pripominka1_at")
  reminder2At DateTime? @map("pripominka2_at")

  @@id([year, id])
  @@map("mcvv_prihlaska_meta")
}

// ============================================
// Zprávy mezi přihlašujícím a pořadatelem (#108)
// ============================================

enum MessageThreadStatus {
  open
  resolved
}

enum MessageSide {
  user
  staff
}

/// Vlákno zpráv: buď k přihlášce (rok + prihlaska_id), nebo obecné k účtu (user_id, bez přihlášky).
/// Přístup přihlašujícího k vláknu přihlášky = e-mail přihlášky se shoduje s e-mailem účtu.
model MessageThread {
  id                 Int                 @id @default(autoincrement())
  /// Účet, který vlákno založil / komu patří (u obecných vláken povinné).
  userId             Int?                @map("user_id")
  year               Int?                @map("rok") @db.SmallInt
  registrationId     Int?                @map("prihlaska_id") @db.SmallInt
  subject            String?             @db.VarChar(200)
  status             MessageThreadStatus @default(open)
  lastMessageAt      DateTime            @default(now()) @map("last_message_at")
  lastUserMessageAt  DateTime?           @map("last_user_message_at")
  lastStaffMessageAt DateTime?           @map("last_staff_message_at")
  /// Přečteno přihlašujícím (jen tlačítko „Potvrdit přečtení“ nebo odpověď).
  lastReadByUser     DateTime?           @map("last_read_by_user")
  /// Přečteno pořadateli (sdílený stav všech pořadatelů).
  lastReadByStaff    DateTime?           @map("last_read_by_staff")
  /// Kdy šlo přihlašujícímu upozornění (1× za cyklus čtení).
  userNotifiedAt     DateTime?           @map("user_notified_at")
  /// Kdy bylo vlákno naposledy v denním souhrnu pro pořadatele.
  staffNotifiedAt    DateTime?           @map("staff_notified_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([year, registrationId])
  @@index([userId])
  @@index([status, lastUserMessageAt])
  @@map("mcvv_message_thread")
}

model Message {
  id           Int         @id @default(autoincrement())
  threadId     Int         @map("thread_id")
  authorUserId Int?        @map("author_user_id")
  side         MessageSide
  body         String      @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("mcvv_message")
}

// ============================================
// Startovka (#114, #115, #116)
// ============================================

/// Rozsah startovních čísel kategorie pro konkrétní rok (kopíruje se z předchozího ročníku).
model CategoryBibRange {
  year       Int    @map("rok") @db.SmallInt
  categoryId String @map("kateg_id") @db.Char(1)
  bibFrom    Int    @map("cislo_od") @db.SmallInt
  bibTo      Int    @map("cislo_do") @db.SmallInt

  @@id([year, categoryId])
  @@map("mcvv_kateg_rocnik")
}

enum StartGroupKind {
  joint
  consecutive
}

/// Požadavek na společný (stejný čas) nebo navazující start skupiny běžců.
model StartGroup {
  id        Int            @id @default(autoincrement())
  year      Int            @map("rok") @db.SmallInt
  kind      StartGroupKind
  note      String?        @map("poznamka") @db.VarChar(200)
  createdAt DateTime       @default(now()) @map("created_at")

  members StartLineMeta[]

  @@index([year])
  @@map("mcvv_start_skupina")
}

/// Doplňková data řádku přihlášky pro startovku (legacy mcvv_prihlaska_radek se nemění):
/// zamčené (ručně změněné) číslo a příslušnost ke skupině.
model StartLineMeta {
  year       Int      @map("rok") @db.SmallInt
  runnerId   String   @map("bezec_id") @db.Char(8)
  locked     Boolean  @default(false) @map("zamceno")
  groupId    Int?     @map("skupina_id")
  groupOrder Int      @default(0) @map("skupina_poradi") @db.SmallInt
  updatedAt  DateTime @updatedAt @map("updated_at")

  runner Runner      @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  group  StartGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@id([year, runnerId])
  @@index([groupId])
  @@map("mcvv_start_radek")
}
